{
  "DATA_DIR": "data",
  "STATE_JSON": "state.json",
  "OUTPUT_CSV": "crash_segments.csv",
  "MAPPING_CSV": "mapping.csv",
  "VIDEO_DIR": "videos",
  "GEOCODE_CACHE": "geocode_cache.json",

  "DISCOVERY_QUERIES": [
    "car crash compilation dashcam",
    "traffic accident compilation dashcam",
    "road crash compilation CCTV",
    "car accidents caught on camera"
  ],
  "SEED_VIDEO_IDS": [],

  "MAX_PAGES_PER_QUERY": 4,
  "RESULTS_PER_PAGE": 50,
  "MAX_NEW_CANDIDATES": 200,
  "MAX_VIDEOS_PER_RUN": 200,

  "CONTINUOUS_MODE": true,
  "ACTIVE_PAUSE_SECONDS": 5,
  "IDLE_PAUSE_SECONDS": 900,

  "TEXT_MODEL": "Qwen/Qwen3-4B-Instruct-2507",
  "TEXT_MODEL_4BIT": true,
  "TEXT_MAX_NEW_TOKENS": 256,
  "MIN_TEXT_CONFIDENCE": 0.65,

  "VISUAL_MODEL": "nvidia/Cosmos3-Nano",
  "VISUAL_MODEL_4BIT": true,
  "VISUAL_MAX_NEW_TOKENS": 768,
  "TEXT_DEVICE": "cuda:0",
  "VISUAL_DEVICE": "cuda:0",

  "MIN_CRASH_CONFIDENCE": 0.65,
  "MIN_BOUNDARY_CONFIDENCE": 0.70,

  "SAMPLE_FRAME_COUNT": 24,
  "SAMPLE_MAX_FPS": 4.0,
  "SAMPLE_WIDTH": 320,
  "BOUNDARY_CONTEXT_SECONDS": 3.0,

  "LOCATION_SAMPLE_FRAME_COUNT": 16,
  "LOCATION_SAMPLE_WIDTH": 960,
  "LOCATION_SAMPLE_MAX_FPS": 2.0,
  "MIN_LOCATION_CONFIDENCE": 0.90,

  "CUT_BACKEND": "ffmpeg_cuda",
  "CUT_FPS": 6.0,
  "CUT_WIDTH": 320,
  "SCENE_THRESHOLD": 0.32,
  "SCDET_THRESHOLD": 10.0,
  "CUT_MERGE_SECONDS": 0.40,
  "CUT_TIMEOUT_SECONDS": 7200,
  "CPU_FALLBACK": true,

  "VIDEO_FORMAT": "bv*[height<=720]+ba/b[height<=720]/bv*[height<=480]+ba/b[height<=480]/best",
  "DOWNLOAD_RETRIES": 5,
  "DOWNLOAD_TIMEOUT_SECONDS": 7200,
  "DELETE_VIDEO_AFTER_PROCESSING": true,
  "COOKIE_FILE": null,

  "ENABLE_GEOCODING": true,
  "GEOCODER_USER_AGENT": "car-crash-yt-research/0.1",
  "GEOCODER_DELAY_SECONDS": 1.1
}