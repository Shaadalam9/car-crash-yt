FROM nvidia/cuda:13.0.2-cudnn-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/car-crash-yt/.venv \
    HF_HOME=/mnt/car-crash-yt/huggingface \
    HF_HUB_CACHE=/mnt/car-crash-yt/huggingface/hub \
    TOKENIZERS_PARALLELISM=false

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        ffmpeg \
        git \
        python3.12 \
        python3.12-venv \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && ln -s /root/.local/bin/uv /usr/local/bin/uv

WORKDIR /opt/car-crash-yt
COPY pyproject.toml README.md ./
RUN uv sync --no-dev --no-install-project

COPY . .
RUN uv sync --no-dev

RUN mkdir -p /mnt/car-crash-yt /run/secrets/car-crash-yt

CMD ["/opt/car-crash-yt/.venv/bin/python", "main.py"]
